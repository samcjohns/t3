# Included in every location, because a location's own add_header discards
# the server's.
add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${T3_API_URL}; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
add_header X-Content-Type-Options nosniff always;
add_header Referrer-Policy strict-origin-when-cross-origin always;
